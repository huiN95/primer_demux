# ========= builder =========
# FROM 192.168.3.38:5000/algo/adacus_dev:1.11.0 AS builder

# ENV DEBIAN_FRONTEND=noninteractive
# # ✨ 加上这两行（若镜像里有 miniconda）
# ENV CONDA_DIR=/root/miniconda3
# ENV PATH="${CONDA_DIR}/bin:${PATH}"
# # 可选：开启 sccache（如果镜像里已预装）
# # ENV RUSTC_WRAPPER=sccache
# # 可选：提高优化、减小体积（也可写在 .cargo/config.toml）
# ENV RUSTFLAGS="-C target-cpu=native -C link-arg=-s"

# WORKDIR /app

# # 1) 先拷贝清单以利用依赖缓存
# # 如果是纯 Rust 工程：拷 Cargo.* 和 src（空占位）
# # 如果有 workspace，请拷贝 workspace Cargo.toml/Cargo.lock
# COPY Cargo.toml Cargo.lock ./
# # 若是 workspace，可把成员 crate 的 Cargo.toml 也先 COPY，视仓库结构调整
# # COPY crates/*/Cargo.toml crates/*/

# # 预热依赖缓存（空 main 占位避免编译失败）
# RUN mkdir -p src && echo 'fn main(){}' > src/main.rs && \
#     . "$HOME/.cargo/env" && \
#     cargo build --release && \
#     rm -rf target/release/deps && \
#     rm -rf src

# # 2) 再拷贝真实源码
# COPY . /app

# # 3) 真正构建与安装
# # 确保 Makefile 的 build-and-install 使用 --release，并安装到 /usr/bin/adapter_demux
# RUN . "$HOME/.cargo/env" && \
#     make build-and-install


# # ========= runtime =========
# # 如需大瘦身，可换小镜像（需保证运行库）：debian:bookworm-slim / distroless 等
# FROM 192.168.3.38:5000/algo/adacus_dev:1.11.0 AS runtime

# ENV RUST_LOG=info \
#     RUST_BACKTRACE=1
# SHELL ["/bin/bash", "-lc"]
# # ENV CONDA_DIR=/root/miniconda3
# # ENV PATH="${CONDA_DIR}/bin:${PATH}"
# # 非 root 运行（可选）
# # RUN useradd -m -u 10001 appuser
# # WORKDIR /home/appuser
# WORKDIR /root
# # 仅复制最终二进制
# COPY --from=builder /usr/bin/adapter_demux /usr/bin/adapter_demux
FROM debian:bookworm-slim AS runtime

ENV RUST_LOG=info \
    RUST_BACKTRACE=1

# 如果你的程序依赖 openssl/zlib 等动态库，在这里补齐
#（根据 ldd 输出调整）
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 非 root 运行（建议）
RUN useradd -m -u 10001 appuser
WORKDIR /home/appuser

COPY --from=builder /usr/bin/adapter_demux /usr/bin/adapter_demux

USER appuser
ENTRYPOINT ["/usr/bin/adapter_demux"]